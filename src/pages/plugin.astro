    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--fg-3);
    white-space: nowrap;
  }
  .cli-tab:hover { background: rgba(255,255,255,0.04); color: var(--fg-1); }
  .cli-tab:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }
  .cli-tab .swatch {
    width: 10px; height: 10px; border-radius: 50%;
