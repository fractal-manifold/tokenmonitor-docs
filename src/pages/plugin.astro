        <p class="lead-sm">Powered on, pairing code visible, plugin installed. From here:</p>
        <div class="flow-row">
          <div>
            <div class="chat-bubble user">I just powered on a new TokenMonitor. It's showing pairing code <code>428 715</code>.</div>
            <div class="chat-bubble cli">I'll configure it. Running <code>/tokenmonitor:configure</code>… Found <code>tmon-3c7c9a02</code> at <code>192.168.1.42</code> via mDNS. Generated a device key and pushed it over the LAN. It's rebooting now — give it ~10 s.</div>
          </div>
          <div>
            <div class="chat-bubble user">Is my broker actually serving it?</div>
            <div class="chat-bubble cli">Called <code>tokenmonitor_status</code>. Broker is running with role <code>leader</code>; it last served <code>tmon-3c7c9a02</code> seconds ago, <strong style="color: var(--color-gold-light);">12 requests</strong> so far. Health <strong style="color: var(--color-success);">PASS</strong>.</div>
            <div class="chat-bubble user">Switch to night mode.</div>
            <div class="chat-bubble cli">Ran <code>/tokenmonitor:theme night</code>. Device acknowledged in 110 ms.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── CTA ────────────────────────────────────────────────── -->
  <Section spacing="flush">
    <div class="close-cta" style="text-align:center; padding: 4rem 2rem; background: var(--color-bg-tertiary); border: var(--border-faint); border-radius: var(--radius-xl); backdrop-filter: blur(8px); margin-top: 4rem;">
      <p class="eyebrow">Next step</p>
      <h2 style="margin-bottom: 1rem">Configure your device.</h2>
      <div class="rule" style="margin: 1.5rem auto;"></div>
      <p style="max-width: 56ch; margin: 0 auto 2rem auto;">With the plugin loaded, <code class="inline-code">/tokenmonitor:configure</code> takes over from here. It discovers the device on your LAN, prompts for the pairing code, pushes the PSK.</p>
      <a href="/setup.html" class="btn btn-primary">Full setup walkthrough <span class="arrow">→</span></a>
    </div>
  </Section>
</Layout>

<script>
  // Two levels of tabs: which CLI (top) and which route within it (terminal /
  // desktop app). Both are wired by the same helper; the route lists are scoped
  // to their own panel so the two levels never steal each other's buttons.
  type TabGroup = { tabs: HTMLElement[]; select: (tab: HTMLElement) => void };

  // Assigned once both groups exist; called after any *user-driven* selection
  // (mouse or keyboard) so the URL tracks the UI either way.
  let syncHash = () => {};

  function wire(tabs: HTMLElement[], panels: HTMLElement[], key: 'cli' | 'route'): TabGroup {
    const panelKey = key === 'cli' ? 'panel' : 'routePanel';
    const select = (tab: HTMLElement) => {
      const value = tab.dataset[key];
      tabs.forEach(t => {
        const on = t === tab;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach(p => p.classList.toggle('active', p.dataset[panelKey] === value));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { select(tab); syncHash(); });
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
        syncHash();
      });
    });
    return { tabs, select };
  }

  const cliTabs = [...document.querySelectorAll<HTMLElement>('.cli-tabs .cli-tab')];
  const cliGroup = wire(cliTabs, [...document.querySelectorAll<HTMLElement>('.cli-panel')], 'cli');

  // One route group per CLI panel. Antigravity has no desktop route and so no
  // .route-tabs element — it simply yields no group.
  const routeGroups = new Map<string, TabGroup>();
  document.querySelectorAll<HTMLElement>('.cli-panel').forEach(panel => {
    const bar = panel.querySelector('.route-tabs');
    if (!bar) return;
    const group = wire(
      [...bar.querySelectorAll<HTMLElement>('.route-tab')],
      [...panel.querySelectorAll<HTMLElement>('.route-panel')],
      'route',
    );
    routeGroups.set(panel.dataset.panel!, group);
  });

  // Keep the URL shareable. replaceState doesn't fire hashchange, so this can't
  // loop back into applyHash().
  syncHash = () => {
    const cli = cliTabs.find(t => t.classList.contains('active'))?.dataset.cli;
    if (!cli) return;
    const route = routeGroups.get(cli)?.tabs.find(t => t.classList.contains('active'))?.dataset.route;
    history.replaceState(null, '', `#${cli}${route && route !== 'terminal' ? `-${route}` : ''}`);
  };

  // Deep links: #codex opens that CLI on its default (terminal) route,
  // #codex-desktop on the desktop-app route. Any other hash — notably the
  // page's own #skills anchor — is left entirely alone.
  const applyHash = () => {
    const hash = location.hash.replace(/^#/, '');
    if (!hash) return;
    const [cli, route] = hash.split('-');
    const cliTab = cliTabs.find(t => t.dataset.cli === cli);
    if (!cliTab) return;
    cliGroup.select(cliTab);
    const group = routeGroups.get(cli);
    if (group) {
      // No route named, or one this CLI doesn't have (#antigravity-desktop):
      // fall back to the first route rather than leaving whatever was open.
      const routeTab = route && group.tabs.find(t => t.dataset.route === route);
      group.select(routeTab || group.tabs[0]);
    }
    syncHash();  // normalises an unsupported route back out of the URL
  };
  applyHash();
  window.addEventListener('hashchange', applyHash);
</script>

<style is:global>
  .page-head {
