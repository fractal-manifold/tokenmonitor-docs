  .cli-tab .swatch.antigravity { background: #3186FF; }
  .cli-tab.active .swatch { opacity: 1; }
  .cli-tab.active.claude .swatch { box-shadow: 0 0 12px rgba(224,122,74,0.7); }
  .cli-tab.active.codex  .swatch { box-shadow: 0 0 12px rgba(30,210,156,0.7); }
  .cli-tab.active.antigravity .swatch { box-shadow: 0 0 12px rgba(49,134,255,0.7); }

  /* Active segment: filled + tinted in the provider's own colour. */
  .cli-tab.active.claude      { background: rgba(224,122,74,0.13); border-color: rgba(224,122,74,0.40); color: #f0a077; }
  .cli-tab.active.codex       { background: rgba(30,210,156,0.13);  border-color: rgba(30,210,156,0.40);  color: #5fe0bb; }
  .cli-tab.active.antigravity { background: rgba(49,134,255,0.13);  border-color: rgba(49,134,255,0.40);  color: #7db0ff; }

  /* On cream, the light brand tones used above wash out — darken the label and
